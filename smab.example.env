# SMA MQTT Bridge: complete public ENV reference. See docs/CONFIGURATION.md.
# On a fresh installation, copy this file to smab.env in the repository root.
# Preserve an existing smab.env; never replace private settings with this example.
# Only the broker placeholder below is active. Uncomment only needed overrides.
# Commented assignments show typed defaults except reduced advanced/diagnostic overrides.
# Advanced/diagnostic examples select false; their built-in default remains true.
# Empty means an empty string.
# Precedence: built-in/profile defaults < optional JSON < explicit ENV values.
# All device sources default to disabled; disabled sources perform no device I/O.
# Paths are container paths unless marked Compose-only. Writes require explicit global and source-specific command gates.
# Single-quote passwords containing $ or # to preserve them literally in Compose.
# Protect the private smab.env with chmod 600. It is excluded from Git and Docker.

# Bridge settings are loaded through Compose env_file without an extra CLI flag.
# Compose-only settings below need --env-file smab.env, shell ENV or a separate .env.

# Deployment image tag; dev Compose builds locally. No release is published yet.
# Type: string; default: latest.
# SMAB_BRIDGE_VERSION=latest

# Host bind directory for JSON, profiles, certificates and secrets; state uses a Docker volume.
# Type: host path; default: ./data/sma-mqtt-bridge.
# SMAB_DATA_DIR=./data/sma-mqtt-bridge

# Optional alternative service ENV file. Also use --env-file for its Compose settings.
# Type: host path; default: ./smab.env.
# SMAB_ENV_FILE=./smab.env

# Container user ID; ensure it can read certificates/secrets and write state.
# Type: integer; default: 10001.
# SMAB_UID=10001

# Container group ID; align host directory permissions without broadening secret access.
# Type: integer; default: 10001.
# SMAB_GID=10001

# Runtime paths and supervision

# Optional JSON. Missing default file is allowed; explicitly selected missing file is an error.
# Type: container path; default: /data/sma-mqtt-bridge/config.json.
# SMAB_CONFIG_FILE=/data/sma-mqtt-bridge/config.json

# Runtime settings

# Maximum UTF-8 bytes per observation payload; oversized values are invalid samples.
# Type: integer; default: 4096; positive.
# SMAB_MAX_PAYLOAD_BYTES=4096

# Container directory for validated profiles/host overrides; invalid overrides fail closed.
# Type: string; default: /data/sma-mqtt-bridge/profiles.
# SMAB_PROFILE_DIR=/data/sma-mqtt-bridge/profiles

# Writable container directory for heartbeat and owned MQTT topic manifest; no credentials.
# Compose mounts data_smab_state here. A path override also requires changing its mount target.
# Type: string; default: /data/sma-mqtt-bridge/state.
# SMAB_STATE_DIR=/data/sma-mqtt-bridge/state

# Valid IANA timezone for local day boundaries.
# Type: string; default: Europe/Berlin.
# SMAB_TIMEZONE=Europe/Berlin

# DEBUG, INFO, WARNING or ERROR; authenticated data is never logged.
# Type: string; default: INFO.
# SMAB_LOG_LEVEL=INFO

# Main-loop heartbeat interval in seconds; positive number.
# Type: number; default: 10.
# SMAB_HEALTH_INTERVAL_SECONDS=10

# Heartbeat failure age in seconds; must exceed HEALTH_INTERVAL_SECONDS.
# Type: number; default: 60.
# SMAB_HEALTH_STALE_SECONDS=60

# Maximum graceful shutdown duration in seconds; positive number.
# Type: number; default: 10.
# SMAB_SHUTDOWN_TIMEOUT_SECONDS=10

# Initial retry delay in seconds, with jitter; positive number.
# Type: number; default: 1.
# SMAB_RECONNECT_MIN_SECONDS=1

# Maximum retry delay in seconds; at least RECONNECT_MIN_SECONDS.
# Type: number; default: 60.
# SMAB_RECONNECT_MAX_SECONDS=60

# Maximum persistent manifest/journal file size; oversized files fail closed.
# Type: integer; default: 1048576; positive bytes.
# SMAB_MAX_STATE_BYTES=1048576

# Whole read-cycle watchdog; polling pauses and idle portal time are excluded.
# Type: number; default: 120; positive seconds.
# SMAB_READ_CYCLE_TIMEOUT_SECONDS=120

# Minimum interval between repeated outage log summaries for each source/client.
# Type: number; default: 300; positive seconds.
# SMAB_FAILURE_LOG_INTERVAL_SECONDS=300

# Maximum HTTP response size including decompressed content; positive integer.
# Type: integer; default: 1048576.
# SMAB_MAX_RESPONSE_BYTES=1048576

# Global command settings (disabled by default)

# Global write gate; local controls also require SMAB_ECHARGER_COMMANDS_ENABLED and the API.
# Type: boolean; default: false.
# SMAB_COMMANDS_ENABLED=false

# Command readback timeout in seconds; positive number.
# Type: number; default: 30.
# SMAB_COMMAND_READBACK_TIMEOUT_SECONDS=30

# Delay between local command readback requests; positive seconds.
# Type: number; default: 1.
# SMAB_COMMAND_READBACK_INTERVAL_SECONDS=1

# Plant calculations (disabled by default; no additional device queries)

# Enable a separate logical Homie plant with an explicitly selected enabled grid source.
# With the local eCharger API enabled, also publish daily kWh on the eCharger
# and household daily kWh without Wallbox on the plant (household AC gate still applies).
# Type: boolean; default: false.
# SMAB_PLANT_ENABLED=false

# Unique Homie identity for the plant.
# Type: string; default: sma-plant.
# SMAB_PLANT_HOMIE_ID=sma-plant

# One enabled grid meter: home-manager, or an inverter with verified grid contribution mappings.
# Type: string; default: home-manager.
# SMAB_PLANT_GRID_SOURCE=home-manager

# Maximum wait between calculation checks; source updates also wake calculations immediately.
# Type: number; default: 1.
# SMAB_PLANT_UPDATE_INTERVAL_SECONDS=1

# Maximum age spread between contributing samples, at most 3600 seconds; freshness still applies.
# Type: number; default: 240.
# SMAB_PLANT_MAX_SKEW_SECONDS=240

# Maximum sampling uncertainty around local midnight, at most 900 seconds; no extrapolation.
# Type: number; default: 240.
# SMAB_PLANT_BOUNDARY_TOLERANCE_SECONDS=240

# Durable counter checkpoint interval; critical baseline/reset transitions are saved immediately.
# Type: number; default: 300.
# SMAB_PLANT_CHECKPOINT_INTERVAL_SECONDS=300

# Deprecated compatibility setting for existing ledger fingerprints/internal counters.
# House lifetime consumption is no longer published; leave existing values unchanged.
# Type: number; default: 0.
# SMAB_PLANT_INITIAL_CONSUMPTION_KWH=0

# Temporarily treat unverified battery energy counters as AC; house kWh is provisional.
# Type: boolean. Default: false. Never overrides a profile declaring DC counters.
# SMAB_PLANT_ASSUME_AC_BATTERY_ENERGY=false

# Test mode: publish initial partial-day deltas from the first valid counter snapshot.
# Type: boolean; default: false. Status stays partial; gaps/resets are not bypassed.
# SMAB_PLANT_PUBLISH_PARTIAL_DAY=false

# Opt-in calculation and selected numeric Modbus evidence; also requires SMAB_LOG_LEVEL=DEBUG.
# Type: boolean; default: false. No extra reads, identity registers or authenticated payloads.
# SMAB_PLANT_DEBUG_ENABLED=false

# Minimum seconds between calculation reports and between reports per mapped register.
# Type: number; default: 60. Must be positive; existing poll intervals remain unchanged.
# SMAB_PLANT_DEBUG_INTERVAL_SECONDS=60

# Source-level optional diagnostics; per-value coverage diagnostics always remain available.
# Type: boolean; default: true. Minimal example: false.
# SMAB_PLANT_DIAGNOSTICS_ENABLED=false

# MQTT connection, Homie and TLS

# Broker hostname/IP; empty default, required for active publishing. Replace the placeholder.
# Type: string; default: empty.
SMAB_MQTT_HOST=mqtt.example.invalid

# Broker TCP port, 1-65535; changing TLS does not automatically change this port.
# Type: integer; default: 8883.
# SMAB_MQTT_PORT=8883

# Optional broker authentication username.
# Type: string; default: empty.
# SMAB_MQTT_USERNAME=

# Account password; use either PASSWORD or PASSWORD_FILE, never both.
# Type: string; default: empty.
# SMAB_MQTT_PASSWORD=

# Container path to a UTF-8 password file; alternative to PASSWORD.
# Type: string; default: empty.
# SMAB_MQTT_PASSWORD_FILE=

# Base MQTT client ID; the bridge derives distinct clients/Last Wills per Homie device.
# Type: string; default: sma-mqtt-bridge.
# SMAB_MQTT_CLIENT_ID=sma-mqtt-bridge

# Single MQTT topic level for Homie; lowercase letters/digits/internal hyphens.
# Type: string; default: homie.
# SMAB_MQTT_HOMIE_PREFIX=homie

# Use TLS. Set false only when explicitly selecting a plaintext broker.
# Type: boolean; default: true.
# SMAB_MQTT_TLS=true

# Certificate/hostname verification; explicit false permits unverified TLS.
# Type: boolean; default: true.
# SMAB_MQTT_TLS_VERIFY=true

# Container path to a trusted broker CA; empty uses system trust.
# Type: string; default: empty.
# SMAB_MQTT_TLS_CA_FILE=

# Container path to an optional mutual-TLS client certificate; pair with TLS_KEY_FILE.
# Type: string; default: empty.
# SMAB_MQTT_TLS_CERT_FILE=

# Container path to the client private key; pair with TLS_CERT_FILE.
# Type: string; default: empty.
# SMAB_MQTT_TLS_KEY_FILE=

# MQTT keepalive in seconds; positive integer.
# Type: integer; default: 60.
# SMAB_MQTT_KEEPALIVE_SECONDS=60

# Bounded MQTT connection timeout in seconds; positive number.
# Type: number; default: 10.
# SMAB_MQTT_CONNECT_TIMEOUT_SECONDS=10

# Homie publication QoS; integer 1 or 2.
# Type: integer; default: 1.
# SMAB_MQTT_QOS=1

# Maximum queued outgoing messages; positive integer.
# Type: integer; default: 1000.
# SMAB_MQTT_MAX_QUEUE_MESSAGES=1000

# Inverter 1: all settings independently selectable

# Enable this source explicitly; addresses or credentials never activate it.
# Type: boolean; default: false.
# SMAB_INVERTER1_ENABLED=false

# Explicit plant role: none, pv, battery or hybrid; never activates this device.
# Type: string; default: none.
# SMAB_INVERTER1_ROLE=none

# Device hostname/IP; required only for this enabled source.
# Type: string; default: empty.
# SMAB_INVERTER1_HOST=

# TCP port, integer 1-65535.
# Type: integer; default: 502.
# SMAB_INVERTER1_PORT=502

# Modbus unit ID, integer 1-247; register functions/types come from the validated profile.
# Type: integer; default: 3.
# SMAB_INVERTER1_UNIT_ID=3

# Reusable model ID or file:<name>.json in PROFILE_DIR. Three bundled inverter profiles have validated read mappings; identity-only files are rejected.
# Type: string; default: sma-stp8-0-3av-40.
# SMAB_INVERTER1_PROFILE=sma-stp8-0-3av-40

# Optional extra serial guard in addition to required profile/model/firmware identity.
# Type: string; default: empty.
# SMAB_INVERTER1_EXPECTED_SERIAL=

# Stable Homie device ID: lowercase letters/digits/internal hyphens; unique per device.
# Type: string; default: sma-inverter1.
# SMAB_INVERTER1_HOMIE_ID=sma-inverter1

# Fallback seconds. Setting this explicitly overrides ALL profile poller intervals.
# Type: number; default: 10.
# SMAB_INVERTER1_POLL_INTERVAL_SECONDS=10

# Bounded device I/O timeout in seconds; positive number.
# Type: number; default: 5.
# SMAB_INVERTER1_TIMEOUT_SECONDS=5

# Maximum data age in seconds; choose a limit compatible with the longest poll interval.
# Type: number; default: 60.
# SMAB_INVERTER1_STALE_SECONDS=60

# Reserved device write gate; true is rejected until its command path exists.
# Type: boolean; default: false.
# SMAB_INVERTER1_COMMANDS_ENABLED=false

# Inverter 2: all settings independently selectable

# Enable this source explicitly; addresses or credentials never activate it.
# Type: boolean; default: false.
# SMAB_INVERTER2_ENABLED=false

# Explicit plant role: none, pv, battery or hybrid; never activates this device.
# Type: string; default: none.
# SMAB_INVERTER2_ROLE=none

# Device hostname/IP; required only for this enabled source.
# Type: string; default: empty.
# SMAB_INVERTER2_HOST=

# TCP port, integer 1-65535.
# Type: integer; default: 502.
# SMAB_INVERTER2_PORT=502

# Modbus unit ID, integer 1-247; register functions/types come from the validated profile.
# Type: integer; default: 3.
# SMAB_INVERTER2_UNIT_ID=3

# Reusable model ID or file:<name>.json in PROFILE_DIR. Three bundled inverter profiles have validated read mappings; identity-only files are rejected.
# Type: string; default: sma-sbs3-7-10.
# SMAB_INVERTER2_PROFILE=sma-sbs3-7-10

# Optional extra serial guard in addition to required profile/model/firmware identity.
# Type: string; default: empty.
# SMAB_INVERTER2_EXPECTED_SERIAL=

# Stable Homie device ID: lowercase letters/digits/internal hyphens; unique per device.
# Type: string; default: sma-inverter2.
# SMAB_INVERTER2_HOMIE_ID=sma-inverter2

# Fallback seconds. Setting this explicitly overrides ALL profile poller intervals.
# Type: number; default: 10.
# SMAB_INVERTER2_POLL_INTERVAL_SECONDS=10

# Bounded device I/O timeout in seconds; positive number.
# Type: number; default: 5.
# SMAB_INVERTER2_TIMEOUT_SECONDS=5

# Maximum data age in seconds; choose a limit compatible with the longest poll interval.
# Type: number; default: 60.
# SMAB_INVERTER2_STALE_SECONDS=60

# Reserved device write gate; true is rejected until its command path exists.
# Type: boolean; default: false.
# SMAB_INVERTER2_COMMANDS_ENABLED=false

# Inverter 3: all settings independently selectable

# Enable this source explicitly; addresses or credentials never activate it.
# Type: boolean; default: false.
# SMAB_INVERTER3_ENABLED=false

# Explicit plant role: none, pv, battery or hybrid; never activates this device.
# Type: string; default: none.
# SMAB_INVERTER3_ROLE=none

# Device hostname/IP; required only for this enabled source.
# Type: string; default: empty.
# SMAB_INVERTER3_HOST=

# TCP port, integer 1-65535.
# Type: integer; default: 502.
# SMAB_INVERTER3_PORT=502

# Modbus unit ID, integer 1-247; register functions/types come from the validated profile.
# Type: integer; default: 3.
# SMAB_INVERTER3_UNIT_ID=3

# Reusable model ID or file:<name>.json in PROFILE_DIR. Three bundled inverter profiles have validated read mappings; identity-only files are rejected.
# Type: string; default: sma-sb4-0-1av-41.
# SMAB_INVERTER3_PROFILE=sma-sb4-0-1av-41

# Optional extra serial guard in addition to required profile/model/firmware identity.
# Type: string; default: empty.
# SMAB_INVERTER3_EXPECTED_SERIAL=

# Stable Homie device ID: lowercase letters/digits/internal hyphens; unique per device.
# Type: string; default: sma-inverter3.
# SMAB_INVERTER3_HOMIE_ID=sma-inverter3

# Fallback seconds. Setting this explicitly overrides ALL profile poller intervals.
# Type: number; default: 10.
# SMAB_INVERTER3_POLL_INTERVAL_SECONDS=10

# Bounded device I/O timeout in seconds; positive number.
# Type: number; default: 5.
# SMAB_INVERTER3_TIMEOUT_SECONDS=5

# Maximum data age in seconds; choose a limit compatible with the longest poll interval.
# Type: number; default: 60.
# SMAB_INVERTER3_STALE_SECONDS=60

# Reserved device write gate; true is rejected until its command path exists.
# Type: boolean; default: false.
# SMAB_INVERTER3_COMMANDS_ENABLED=false

# Further inverters: repeat ANY INVERTER1 suffix with a positive slot number (4, 5, ...).
# For slots above 3, PROFILE defaults to empty and must be explicitly selected when enabled.
# HOMIE_ID defaults to sma-inverter<N>; all other defaults match INVERTER1.
# No model-specific adapter changes are needed for additional validated profile files.

# Sunny Home Manager 2.0: selectable UDP meter or read-only Modbus TCP

# Enable this source explicitly; addresses or credentials never activate it.
# Type: boolean; default: false.
# SMAB_HOME_MANAGER_ENABLED=false

# Select udp or modbus-tcp; exactly one transport owns Home Manager values.
# Type: string; default: udp.
# SMAB_HOME_MANAGER_TRANSPORT=udp

# Bundled Modbus read profile ID or file:host-profile.json; ignored for UDP.
# Type: string; default: sma-home-manager-2-modbus.
# SMAB_HOME_MANAGER_PROFILE=sma-home-manager-2-modbus

# Modbus TCP port, 1-65535; independent from the existing UDP PORT.
# Type: integer; default: 502.
# SMAB_HOME_MANAGER_MODBUS_PORT=502

# Explicit positive override for Unit 2 intervals; otherwise preserve profile schedules.
# Type: number; default: 3.
# SMAB_HOME_MANAGER_POLL_INTERVAL_SECONDS=3

# Positive Modbus TCP connection timeout in seconds.
# Type: number; default: 5.
# SMAB_HOME_MANAGER_CONNECT_TIMEOUT_SECONDS=5

# Minimum delay after each Modbus transaction, in seconds; zero allowed.
# Type: number; default: 0.2.
# SMAB_HOME_MANAGER_TRANSACTION_DELAY_SECONDS=0.2

# Delay before the first Modbus identity read, in seconds; zero allowed.
# Type: number; default: 3.
# SMAB_HOME_MANAGER_AFTER_CONNECTION_DELAY_SECONDS=3

# Minimum delay after closing a Modbus connection, in seconds; zero allowed.
# Type: number; default: 5.
# SMAB_HOME_MANAGER_RECONNECT_DELAY_SECONDS=5

# Optional UDP sender IPv4 filter; required TCP host for modbus-tcp.
# Type: string; default: empty.
# SMAB_HOME_MANAGER_HOST=

# Required decimal serial selector when enabled; verifies telegrams or Modbus identity.
# Type: string; default: empty.
# SMAB_HOME_MANAGER_SERIAL=

# Local IPv4 interface for multicast; 0.0.0.0 selects the system default.
# Type: string; default: 0.0.0.0.
# SMAB_HOME_MANAGER_INTERFACE_ADDRESS=0.0.0.0

# Local IPv4 UDP listening address; 0.0.0.0 listens on all interfaces.
# Type: string; default: 0.0.0.0.
# SMAB_HOME_MANAGER_BIND_ADDRESS=0.0.0.0

# UDP meter port, integer 1-65535.
# Type: integer; default: 9522.
# SMAB_HOME_MANAGER_PORT=9522

# Join the configured IPv4 group; false requires separately arranged direct delivery.
# Type: boolean; default: true.
# SMAB_HOME_MANAGER_MULTICAST_ENABLED=true

# IPv4 meter multicast group; LAN delivery must be verified on the Raspberry Pi.
# Type: string; default: 239.12.255.254.
# SMAB_HOME_MANAGER_MULTICAST_GROUP=239.12.255.254

# Bounded device I/O timeout in seconds; positive number.
# Type: number; default: 5.
# SMAB_HOME_MANAGER_TIMEOUT_SECONDS=5

# Maximum data age in seconds; expired values become unavailable, never zero.
# Type: number; default: 30.
# SMAB_HOME_MANAGER_STALE_SECONDS=30

# Stable Homie device ID: lowercase letters/digits/internal hyphens; unique per device.
# Type: string; default: sma-home-manager.
# SMAB_HOME_MANAGER_HOMIE_ID=sma-home-manager

# Local eCharger HTTPS API and independently enabled HTTP SEMP

# Enable local HTTPS API reads only; does not enable SEMP.
# Type: boolean; default: false.
# SMAB_ECHARGER_ENABLED=false

# Trusted certificate DNS name/IP of the local charger; shared by API and SEMP.
# Type: string; default: empty.
# SMAB_ECHARGER_HOST=

# Local HTTPS API port, 1-65535; HTTPS certificate/hostname verification is mandatory.
# Type: integer; default: 443.
# SMAB_ECHARGER_PORT=443

# Local charger account; separate from the portal account.
# Type: string; default: empty.
# SMAB_ECHARGER_USERNAME=

# Account password; use either PASSWORD or PASSWORD_FILE, never both.
# Type: string; default: empty.
# SMAB_ECHARGER_PASSWORD=

# Container path to a UTF-8 password file; alternative to PASSWORD.
# Type: string; default: empty.
# SMAB_ECHARGER_PASSWORD_FILE=

# Container path to trusted local charger certificate/CA; empty uses system trust.
# Type: string; default: empty.
# SMAB_ECHARGER_TLS_CA_FILE=

# Local API certificate verification; false explicitly permits unverified local TLS.
# Type: boolean; default: true.
# SMAB_ECHARGER_TLS_VERIFY=true

# Optional certificate DNS name when connecting to HOST/IP. Empty verifies HOST.
# Type: string; default: empty.
# SMAB_ECHARGER_TLS_SERVER_NAME=

# Required serial guard for local API; optional additional SEMP identity check.
# Type: string; default: empty.
# SMAB_ECHARGER_EXPECTED_SERIAL=

# Local parameter/live-data polling seconds; positive number, independent of SEMP.
# Type: number; default: 60.
# SMAB_ECHARGER_API_POLL_INTERVAL_SECONDS=60

# Enable local SEMP reads independently; no local API credentials required.
# Type: boolean; default: false.
# SMAB_ECHARGER_SEMP_ENABLED=false

# Local HTTP SEMP port, integer 1-65535.
# Type: integer; default: 80.
# SMAB_ECHARGER_SEMP_PORT=80

# Absolute local SEMP endpoint path.
# Type: string; default: /SEMP/.
# SMAB_ECHARGER_SEMP_PATH=/SEMP/

# SEMP polling seconds; positive number, independent of API.
# Type: number; default: 30.
# SMAB_ECHARGER_SEMP_POLL_INTERVAL_SECONDS=30

# Required SEMP device ID selector when SEMP is enabled.
# Type: string; default: empty.
# SMAB_ECHARGER_SEMP_DEVICE_ID=

# Bounded device I/O timeout in seconds; positive number.
# Type: number; default: 10.
# SMAB_ECHARGER_TIMEOUT_SECONDS=10

# Maximum data age in seconds; expired values become unavailable, never zero.
# Type: number; default: 180.
# SMAB_ECHARGER_STALE_SECONDS=180

# Observe existing API/SEMP sample timestamps in the state volume; no extra requests.
# Independent of Homie diagnostics; disabled sources remain inactive.
# Type: boolean; default: false.
# SMAB_ECHARGER_TIMESTAMP_DIAGNOSTICS_ENABLED=false

# Rotate echarger-timestamps.jsonl with one backup; bytes per file, 4096-16777216.
# Type: integer; default: 1048576.
# SMAB_ECHARGER_TIMESTAMP_DIAGNOSTICS_MAX_BYTES=1048576

# Summarize unchanged samples after this interval; changes are recorded immediately.
# Type: number; default: 300; positive seconds.
# SMAB_ECHARGER_TIMESTAMP_DIAGNOSTICS_SUMMARY_INTERVAL_SECONDS=300

# Shared stable Homie identity for local charger, SEMP and portal properties.
# Type: string; default: sma-echarger.
# SMAB_ECHARGER_HOMIE_ID=sma-echarger

# Local command gate; also requires SMAB_COMMANDS_ENABLED and enabled local API.
# Type: boolean; default: false.
# SMAB_ECHARGER_COMMANDS_ENABLED=false

# Optional ennexOS portal reader

# Enable optional ennexOS minimum-PV reader separately from all local sources.
# Type: boolean; default: false.
# SMAB_PORTAL_ENABLED=false

# HTTPS portal origin; verified TLS is mandatory.
# Type: string; default: https://ennexos.sunnyportal.com.
# SMAB_PORTAL_BASE_URL=https://ennexos.sunnyportal.com

# HTTPS ennexOS API base; no paid SMA Developer API.
# Type: string; default: https://uiapi.sunnyportal.com/api/v1.
# SMAB_PORTAL_API_BASE_URL=https://uiapi.sunnyportal.com/api/v1

# HTTPS authentication realm; login actions must stay on this origin/path.
# Type: string; default: https://login.sma.energy/auth/realms/SMA.
# SMAB_PORTAL_AUTH_BASE_URL=https://login.sma.energy/auth/realms/SMA

# Public web OAuth client ID; not a developer credential or secret.
# Type: string; default: SPpbeOS.
# SMAB_PORTAL_CLIENT_ID=SPpbeOS

# Normal portal account username; separate from local charger credentials.
# Type: string; default: empty.
# SMAB_PORTAL_USERNAME=

# Account password; use either PASSWORD or PASSWORD_FILE, never both.
# Type: string; default: empty.
# SMAB_PORTAL_PASSWORD=

# Container path to a UTF-8 password file; alternative to PASSWORD.
# Type: string; default: empty.
# SMAB_PORTAL_PASSWORD_FILE=

# Required portal plant selector when this source is enabled.
# Type: string; default: empty.
# SMAB_PORTAL_PLANT_ID=

# Required portal charger device selector when this source is enabled.
# Type: string; default: empty.
# SMAB_PORTAL_DEVICE_ID=

# Bounded device I/O timeout in seconds; positive number.
# Type: number; default: 15.
# SMAB_PORTAL_TIMEOUT_SECONDS=15

# 0 disables startup login and periodic reads; --refresh-portal requests one read.
# Type: number; default: 0.
# SMAB_PORTAL_POLL_INTERVAL_SECONDS=0

# Maximum data age in seconds; expired values become unavailable, never zero.
# With periodic polling, allow the interval plus request/scheduling time.
# Example: POLL_INTERVAL_SECONDS=900 and STALE_SECONDS=1800.
# Type: number; default: 180.
# SMAB_PORTAL_STALE_SECONDS=180

# Portal PV write gate; also requires SMAB_COMMANDS_ENABLED and SMAB_PORTAL_ENABLED.
# Type: boolean; default: false.
# SMAB_PORTAL_COMMANDS_ENABLED=false

# Include advanced read channels; identity checks always remain active.
# Type: boolean; default: true.
# SMAB_INVERTER1_ADVANCED_CHANNELS_ENABLED=false

# Publish optional diagnostics; operational source status is always available.
# Type: boolean; default: true.
# SMAB_INVERTER1_DIAGNOSTICS_ENABLED=false

# Required fresh node/property keys, comma-separated; empty uses adapter/profile defaults.
# Type: string; default: empty; keys must be advertised by this source.
# SMAB_INVERTER1_READY_PROPERTIES=


# Include advanced read channels; identity checks always remain active.
# Type: boolean; default: true.
# SMAB_INVERTER2_ADVANCED_CHANNELS_ENABLED=false

# Publish optional diagnostics; operational source status is always available.
# Type: boolean; default: true.
# SMAB_INVERTER2_DIAGNOSTICS_ENABLED=false

# Required fresh node/property keys, comma-separated; empty uses adapter/profile defaults.
# Type: string; default: empty; keys must be advertised by this source.
# SMAB_INVERTER2_READY_PROPERTIES=


# Include advanced read channels; identity checks always remain active.
# Type: boolean; default: true.
# SMAB_INVERTER3_ADVANCED_CHANNELS_ENABLED=false

# Publish optional diagnostics; operational source status is always available.
# Type: boolean; default: true.
# SMAB_INVERTER3_DIAGNOSTICS_ENABLED=false

# Required fresh node/property keys, comma-separated; empty uses adapter/profile defaults.
# Type: string; default: empty; keys must be advertised by this source.
# SMAB_INVERTER3_READY_PROPERTIES=


# Include advanced read channels; identity checks always remain active.
# Type: boolean; default: true.
# SMAB_HOME_MANAGER_ADVANCED_CHANNELS_ENABLED=false

# Publish optional diagnostics; operational source status is always available.
# Type: boolean; default: true.
# SMAB_HOME_MANAGER_DIAGNOSTICS_ENABLED=false

# Required fresh node/property keys, comma-separated; empty uses adapter/profile defaults.
# Type: string; default: empty; keys must be advertised by this source.
# SMAB_HOME_MANAGER_READY_PROPERTIES=


# Include advanced read channels; identity checks always remain active.
# Type: boolean; default: true.
# SMAB_ECHARGER_ADVANCED_CHANNELS_ENABLED=false

# Publish optional diagnostics; operational source status is always available.
# Type: boolean; default: true.
# SMAB_ECHARGER_DIAGNOSTICS_ENABLED=false

# Required fresh SEMP node/property keys; empty uses adapter defaults.
# Type: string; default: empty; comma-separated advertised keys.
# SMAB_ECHARGER_SEMP_READY_PROPERTIES=

# Required fresh API node/property keys; empty uses adapter defaults.
# Type: string; default: empty; comma-separated advertised keys.
# SMAB_ECHARGER_API_READY_PROPERTIES=


# Publish optional diagnostics; operational source status is always available.
# Type: boolean; default: true.
# SMAB_PORTAL_DIAGNOSTICS_ENABLED=false

# Required fresh node/property keys, comma-separated; empty uses adapter/profile defaults.
# Type: string; default: empty; keys must be advertised by this source.
# SMAB_PORTAL_READY_PROPERTIES=

# Display labels only; IDs, units, enum values and commands remain language-independent.
# Type: string; default: en. Bundled: en/de; custom language needs <language>.json.
# SMAB_LANGUAGE=en

# Host overrides for display labels; files use schemaVersion 1 and a labels dictionary.
# Type: container path; default: /data/sma-mqtt-bridge/translate.
# SMAB_TRANSLATE_DIR=/data/sma-mqtt-bridge/translate
