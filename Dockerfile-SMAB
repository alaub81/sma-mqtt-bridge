# Verified stable official tag and multi-platform index on 2026-10-20.
FROM python:3.15.0-slim-trixie@sha256:2da676046630d7bf14c6764ae1143dc7fa0377a53f94bf5a642f0b214aca5bce

WORKDIR /app
COPY ressources/requirements.txt ./
RUN python -m pip install --no-cache-dir --requirement requirements.txt \
    && python -m pip check \
    && python -m pip uninstall --yes pip \
    && python -c 'import shutil, sysconfig; shutil.rmtree(sysconfig.get_path("stdlib") + "/ensurepip")' \
    && groupadd --gid 10001 smab \
    && useradd --uid 10001 --gid smab --no-create-home smab \
    && mkdir -p /data/sma-mqtt-bridge/state \
    && chown -R smab:smab /data/sma-mqtt-bridge
COPY ressources/ ./

ARG SMAB_BUILD_VERSION=0.0.0+unknown
RUN python -c 'import os, pathlib; from sma_mqtt_bridge.version import VERSION; value = os.environ["SMAB_BUILD_VERSION"]; assert VERSION.fullmatch(value), "Invalid build version"; pathlib.Path("sma_mqtt_bridge/_build_version.txt").write_text(value + "\n", encoding="utf-8")'

ENV SMAB_STATE_DIR=/data/sma-mqtt-bridge/state
USER 10001:10001
VOLUME ["/data/sma-mqtt-bridge/state"]
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-m", "sma_mqtt_bridge", "--healthcheck"]
ENTRYPOINT ["python", "-m", "sma_mqtt_bridge"]
