# Optional Docker Compose interpolation settings: copy to .env.
# Bridge/device settings and credentials belong in smab.env, not here.
# Keep your existing Compose project name to preserve the state volume.
# All assignments below are optional; the Compose file supplies these defaults.

# Published image tag; use an explicit release tag when desired.
# SMAB_BRIDGE_VERSION=latest

# Service environment file, read by Compose on the host.
# SMAB_ENV_FILE=./smab.env

# Read-only host configuration directory.
# SMAB_DATA_DIR=./data/sma-mqtt-bridge

# Container UID/GID; prepare matching access to configuration and state.
# SMAB_UID=10001
# SMAB_GID=10001
